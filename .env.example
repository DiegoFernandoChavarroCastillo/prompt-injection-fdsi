# Copia este archivo a .env y completa los valores:
#     cp .env.example .env
#
# .env está en .gitignore y NUNCA debe subirse al repositorio.
# Cada integrante del equipo usa su propia clave.

# Clave del proveedor. Groq: https://console.groq.com/keys
LLM_API_KEY=

# Opcional. Si se deja vacío, se usa el base_url de config/experiment.yaml.
# Sólo hay que llenarlo para apuntar a otro proveedor desde esta máquina
# (plan B, Gemini: https://generativelanguage.googleapis.com/v1beta/openai/).
LLM_BASE_URL=
